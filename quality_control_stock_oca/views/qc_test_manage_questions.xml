<odoo>
    <record id="qc_test_question_tree_view" model="ir.ui.view">
        <field name="name">qc.test.question.list</field>
        <field name="model">qc.test.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type" />
                <field name="min_value" />
                <field name="max_value" />
                <field name="uom_id" />
                <field name="sequence" />
                <field name="notes" />
            </list>
        </field>
    </record>

    <record id="qc_test_questions_action" model="ir.actions.act_window">
        <field name="name">Test Questions</field>
        <field name="res_model">qc.test.question</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="qc_test_question_tree_view" />
        <field
            name="domain"
        >['|', ("test", "=", active_id), ("test_id", "=", active_id)]</field>
        <field
            name="context"
        >{"default_test": active_id, "default_test_id": active_id}</field>
    </record>

    <record id="qc_test_view_form_manage_questions" model="ir.ui.view">
        <field name="name">qc.test.form.manage.questions</field>
        <field name="model">qc.test</field>
        <field name="inherit_id" ref="quality_control_oca.qc_test_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='test_lines']" position="before">
                <button
                    name="%(qc_test_questions_action)d"
                    type="action"
                    string="Soruları Liste Olarak Aç (Import/Export)"
                    class="oe_highlight"
                />
            </xpath>
        </field>
    </record>
</odoo>
